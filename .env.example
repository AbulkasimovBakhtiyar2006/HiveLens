# Meta Model API key (https://dev.meta.ai). Copy this file to .env and paste your key.
MODEL_API_KEY=

# Optional overrides
# HIVELENS_REASONING_MODEL=muse-spark-1.3
# HIVELENS_SEGMENT_MODEL=sam-3.1
# HIVELENS_REASONING_EFFORT=medium
# HIVELENS_DATA_DIR=./data

# Optional Google Maps. Without a key, location maps use OpenStreetMap.
# This is a PUBLIC browser key. Restrict it to your site's HTTP referrers and
# Maps JavaScript API in Google Cloud. Never reuse a private server/model key.
# GOOGLE_MAPS_BROWSER_KEY=
# Optional map ID for your cloud map style (DEMO_MAP_ID is used for prototyping).
# GOOGLE_MAPS_MAP_ID=
